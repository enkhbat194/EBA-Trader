# EBA Trader runtime defaults
EBA_EXECUTION_MODE=paper
EBA_SYMBOL=BTCUSDT
EBA_PRIMARY_VENUE=BINANCE

# Binance public market data requires no credentials.
EBA_BINANCE_DATA_ENV=live_public

# Persistent Linode runtime state.
EBA_LEDGER_DB=/var/lib/eba-trader/eba_trader.db
EBA_RUNTIME_API_HOST=127.0.0.1
EBA_RUNTIME_API_PORT=8765

# Optional Binance Demo credentials only.
# Keep secrets in the server environment file; never commit them to Git.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
