# EBA Trader V1 uses paper/shadow mode only by default.
EBA_EXECUTION_MODE=paper
EBA_SYMBOL=BTCUSDT
EBA_PRIMARY_VENUE=BINANCE

# Market-data environment:
# - live_public: public Binance Spot market data, no API key required
# - demo: Binance Demo environment; credentials must come from env only
EBA_BINANCE_DATA_ENV=live_public

# Binance Demo credentials only. Never commit real keys or secrets.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
