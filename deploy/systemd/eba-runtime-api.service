[Unit]
Description=EBA Trader persistent runtime API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Eba-Trader
EnvironmentFile=-/etc/eba-trader/eba-trader.env
Environment=EBA_LEDGER_DB=/var/lib/eba-trader/eba_trader.db
Environment=EBA_RUNTIME_API_HOST=127.0.0.1
Environment=EBA_RUNTIME_API_PORT=8765
ExecStart=/opt/Eba-Trader/.venv/bin/eba-runtime-api
Restart=always
RestartSec=5
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/eba-trader

StandardOutput=journal
StandardError=journal
SyslogIdentifier=eba-runtime-api

[Install]
WantedBy=multi-user.target
