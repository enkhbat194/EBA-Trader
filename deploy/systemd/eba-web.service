[Unit]
Description=EBA Trader Linode PWA and paper scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Eba-Trader
EnvironmentFile=-/etc/eba-trader/eba-trader.env
Environment=EBA_LEDGER_DB=/var/lib/eba-trader/eba_trader.db
Environment=EBA_WEB_HOST=127.0.0.1
Environment=EBA_WEB_PORT=8000
ExecStart=/opt/Eba-Trader/.venv/bin/eba-web
Restart=always
RestartSec=5
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/eba-trader

StandardOutput=journal
StandardError=journal
SyslogIdentifier=eba-web

[Install]
WantedBy=multi-user.target
